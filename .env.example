# Copy to .env and fill in real values. .env is gitignored; .env.example is not.

# Mesh / external research APIs
GEMINI_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
HEURIST_API_KEY=
WEB_SEARCH_PROVIDER=firecrawl

# AWS — Bedrock (research/response/chart agents) + AgentCore Code Interpreter
# Bedrock account must have Anthropic Claude use-case approval submitted.
AWS_REGION=us-west-2
AWS_PROFILE=payments-admin
BEDROCK_PROFILE=payments-admin
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
CHART_AGENT_TIMEOUT_S=120
CHART_AGENT_MAX_TOKENS=8000

# Cloudflare R2 — chart/news image artifact storage.
# Bucket must allow public read via the custom domain.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=heurist-finance
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_BASE_URL=https://hf-data.heurist.xyz

# Daily SQLite backup (pm2 `hf-db-backup`, ops/db_backup_scheduler.py)
# DB_BACKUP_DISABLED=1
# DB_BACKUP_HOUR_UTC=4
# DB_BACKUP_MINUTE_UTC=0
# DB_BACKUP_RETENTION_DAYS=7
# DB_BACKUP_R2_PREFIX=backups/db
# DB_BACKUP_LOCAL_DIR=backups/db

# Alpaca — equity market data
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_BASE=https://data.alpaca.markets
ALPACA_STOCK_FEED=iex

# EODHD — commodity/FX fallback price data (comma-separated keys for rotation)
EODHD_API_KEYS=

# Strands agent knobs
# Each phase picks its provider independently: "bedrock" (default) or
# "composer" to route that phase through composer-relay's OpenAI-compatible
# chat-completions endpoint. There is no global switch.
RESEARCH_MODEL_PROVIDER=bedrock
RESPONSE_MODEL_PROVIDER=bedrock
CHART_MODEL_PROVIDER=bedrock
COMPOSER_RELAY_BASE_URL=http://127.0.0.1:4005/v1
COMPOSER_RELAY_API_KEY=
COMPOSER_RELAY_MODEL_ID=composer-2.5-fast
RESEARCH_MAX_TOKENS=12000
AGENT_TIMEOUT_SECONDS=300
RESPONSE_BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
RESPONSE_MAX_TOKENS=10000
# Response extended thinking is mode-driven (quick=off, deep=1024-token budget),
# not an env toggle. Composer phases ignore Bedrock thinking fields entirely.

# Heurist Mesh (agent allowlist is hardcoded in src/clients/mesh.py)
MESH_API_ENDPOINT=https://mesh.heurist.xyz

# AgentCore Payments (x402) — per-user wallets + spend quotas.
# See docs/design-agentcore-payments.md. Defaults point at the permanent live
# resources in account 441070252417 (reuses AWS_PROFILE above), so these are
# only needed to override the account/network or set default caps. Blank
# AGENTPAY_MANAGER_ARN disables the /api/v1/payments/* surface (returns 503).
# AGENTPAY_MANAGER_ARN=arn:aws:bedrock-agentcore:us-west-2:441070252417:payment-manager/mypaymentmanager-ysmz9kzgdx
# AGENTPAY_CONNECTOR_ID=mycoinbaseconnector-s8a2swf9ic
# AGENTPAY_MANAGEMENT_ROLE_ARN=arn:aws:iam::441070252417:role/AgentCorePaymentsManagementRole
# AGENTPAY_PROCESS_PAYMENT_ROLE_ARN=arn:aws:iam::441070252417:role/AgentCorePaymentsProcessPaymentRole
# AGENTPAY_WALLET_NETWORK=ETHEREUM            # CDP embedded-wallet family
# AGENTPAY_X402_NETWORK=base                  # default chain (Base mainnet — real USDC; use base-sepolia for testnet)
# AGENTPAY_LINKED_EMAIL_DOMAIN=hf-users.heurist.xyz
# AGENTPAY_SESSION_EXPIRY_MINUTES=60
# AGENTPAY_DEFAULT_MAX_PER_QUERY_USD=         # blank = unlimited until set per user
# AGENTPAY_DEFAULT_MAX_PER_DAY_USD=
# AGENTPAY_USDC_DECIMALS=6

# Internal dev metrics API + frontend /metrics console
HF_INTERNAL_METRICS_ENABLED=1

# Langfuse tracing (optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_ENVIRONMENT=development
LANGFUSE_SERVICE_NAME=heurist-finance-backend
